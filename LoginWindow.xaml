<Window x:Class="Advent_calendar_Deambrogio_Barthod.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Calendrier de l'Avent - Connexion"
        Height="500" Width="600"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStyle="None">

    <Border CornerRadius="20" BorderThickness="2">
        <Border.BorderBrush>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FFD700" Offset="0"/>
                <GradientStop Color="#FFA500" Offset="1"/>
            </LinearGradientBrush>
        </Border.BorderBrush>

        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#4A0E0E" Offset="0"/>
                <GradientStop Color="#6B1616" Offset="0.5"/>
                <GradientStop Color="#8B1A1A" Offset="1"/>
            </LinearGradientBrush>
        </Border.Background>

        <Border.Effect>
            <DropShadowEffect Color="Black" BlurRadius="30" ShadowDepth="0" Opacity="0.8"/>
        </Border.Effect>

        <Grid>
            <!-- Canvas pour la neige -->
            <Canvas x:Name="SnowCanvas" ClipToBounds="True"/>

            <StackPanel VerticalAlignment="Center" Margin="50">
                <!-- Titre -->
                <TextBlock FontSize="48" FontWeight="Bold" TextAlignment="Center" Margin="0,0,0,20">
                    <TextBlock.Foreground>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#FFD700" Offset="0"/>
                            <GradientStop Color="#FFA500" Offset="0.5"/>
                            <GradientStop Color="#FFD700" Offset="1"/>
                        </LinearGradientBrush>
                    </TextBlock.Foreground>
                    <TextBlock.Effect>
                        <DropShadowEffect Color="#C41E3A" BlurRadius="20" ShadowDepth="0" Opacity="0.8"/>
                    </TextBlock.Effect>
                    🎄 Bienvenue 🎄
                </TextBlock>

                <!-- Sous-titre -->
                <TextBlock Text="Calendrier de l'Avent Magique"
                           FontSize="20"
                           Foreground="White"
                           TextAlignment="Center"
                           Margin="0,0,0,40"
                           Opacity="0.9"/>

                <!-- Label prénom -->
                <TextBlock Text="Entrez votre prénom :"
                           FontSize="18"
                           Foreground="White"
                           FontWeight="SemiBold"
                           Margin="0,0,0,10"/>

                <!-- Zone de saisie -->
                <Border Background="#5A1616" 
                        CornerRadius="15" 
                        BorderThickness="2"
                        Margin="0,0,0,30">
                    <Border.BorderBrush>
                        <SolidColorBrush Color="#FFD700" Opacity="0.5"/>
                    </Border.BorderBrush>
                    <TextBox x:Name="PrenomTextBox"
                             FontSize="24"
                             Foreground="White"
                             Background="Transparent"
                             BorderThickness="0"
                             Padding="15"
                             VerticalContentAlignment="Center"
                             MaxLength="20"
                             KeyDown="PrenomTextBox_KeyDown">
                        <TextBox.CaretBrush>
                            <SolidColorBrush Color="White"/>
                        </TextBox.CaretBrush>
                    </TextBox>
                </Border>

                <!-- Message d'erreur -->
                <TextBlock x:Name="ErrorText"
                           Text=""
                           FontSize="14"
                           Foreground="#FF6B6B"
                           TextAlignment="Center"
                           Margin="0,0,0,20"
                           Visibility="Collapsed"/>

                <!-- Bouton Continuer -->
                <Button x:Name="ContinuerButton"
                        Content="✨ Continuer ✨"
                        FontSize="22"
                        FontWeight="Bold"
                        Height="60"
                        Click="ContinuerButton_Click"
                        Cursor="Hand">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="White"/>
                            <Setter Property="Foreground" Value="DarkGreen"/>
                            <Setter Property="BorderThickness" Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border x:Name="ButtonBorder" 
                                                Background="{TemplateBinding Background}" 
                                                CornerRadius="30">
                                            <Border.Effect>
                                                <DropShadowEffect Color="Gold" BlurRadius="20" ShadowDepth="0" Opacity="0.6"/>
                                            </Border.Effect>
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="ButtonBorder" Property="Background">
                                                    <Setter.Value>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                            <GradientStop Color="#FFFFFF" Offset="0"/>
                                                            <GradientStop Color="#FFF8DC" Offset="1"/>
                                                        </LinearGradientBrush>
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </Button.Style>
                </Button>

                <!-- Info utilisateurs existants -->
                <TextBlock x:Name="ExistingUsersText"
                           FontSize="12"
                           Foreground="White"
                           TextAlignment="Center"
                           Margin="0,20,0,0"
                           Opacity="0.7"
                           Visibility="Collapsed"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>